# API runtime
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Neon PostgreSQL — the only database
# ---------------------------------------------------------------------------
# Pooled connection string (Neon console -> Connect -> Pooled connection).
# Used by the API for all reads and writes.
POSTGRES_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection string. DDL/migrations must not run through the
# pooler because schema changes need a dedicated session.
MIGRATIONS_DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT.<region>.aws.neon.tech/neondb?sslmode=require
# Copy both from the Neon console -> your project -> Connect (see
# docs/09_Firebase_Neon_Setup.md). URL-encode special characters in the
# password. Keep this file out of git.
REDIS_URL=redis://localhost:6379
# Signs the platform's own short-lived API session tokens (not Firebase tokens).
JWT_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Firebase Auth — the only identity provider
# ---------------------------------------------------------------------------
# Server-side verification of Firebase ID tokens needs only the project id:
# signing certificates are fetched from Google and cached. No service account
# key is required, and no Firebase secret may ever ship in the Android APK.
AUTH_PROVIDER=firebase
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
# Public web API key from the Firebase console (Project settings -> Web app).
# Only needed for read-only Identity Toolkit lookups; it is not a secret
# credential, but it still stays on the server.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# Providers allowed to create or sign in to an account. anonymous and custom are
# never accepted. Do NOT add phone.com: phone OTP is for cash-withdrawal
# verification (Minimum KYC) only, and the API rejects it as a sign-in method
# even when listed here.
FIREBASE_ALLOWED_SIGN_IN_PROVIDERS=emailLink,google.com
# Override only for local token-issuer testing. Leave unset in production.
# FIREBASE_CERTS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com

# ---------------------------------------------------------------------------
# Product and compliance gates (fail-closed)
# ---------------------------------------------------------------------------
# Master switch for Firebase sign-in/account creation. Enable only after the
# Firebase project is configured and reviewed policy URLs are published.
SIGNUP_ENABLED=false
MINIMUM_USER_AGE=18
GOOGLE_SIGNIN_ENABLED=false
GOOGLE_WEB_CLIENT_ID=configure-google-oauth-web-client-id
TERMS_VERSION=publish-reviewed-terms-version
PRIVACY_VERSION=publish-reviewed-privacy-version
TERMS_URL=https://your-domain.example/terms
PRIVACY_URL=https://your-domain.example/privacy
SUPPORT_EMAIL=support@your-domain.example
# Play Store requires a public web page with account deletion instructions.
ACCOUNT_DELETION_URL=https://your-domain.example/delete-account

# ---------------------------------------------------------------------------
# Transactional email (Resend) — receipts and support replies only.
# Firebase sends its own verification mail; this is not part of sign-in.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Play and Earn <noreply@your-verified-domain.example>

# ---------------------------------------------------------------------------
# Legacy self-hosted phone OTP (Fast2SMS). Firebase phone auth is the primary
# Minimum-KYC path; keep this disabled unless DLT templates are approved.
# ---------------------------------------------------------------------------
OTP_DELIVERY_ENABLED=false
OTP_HASH_SECRET=replace-with-a-different-long-random-secret
OTP_PROVIDER=fast2sms
OTP_PROVIDER_API_KEY=configure-after-fast2sms-and-DLT-approval
