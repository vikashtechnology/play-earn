{
  "name": "rewards-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:api && npm run build:validation",
    "dev:api": "npm --workspace @rewards-platform/api run dev",
    "config:check": "npm --workspace @rewards-platform/api run config:check",
    "neon:login": "neonctl auth",
    "neon:setup": "neonctl projects create --name play-earn --region-id aws-ap-southeast-1",
    "neon:link": "neonctl projects link",
    "neon:cs": "neonctl connection-string --pooled",
    "neon:cs:direct": "neonctl connection-string",
    "build:api": "npm --workspace @rewards-platform/api run build",
    "build:validation": "npm --workspace @rewards-platform/validation run build",
    "test": "npm --workspace @rewards-platform/api run test && npm --workspace @rewards-platform/validation run test",
    "lint:api": "npm --workspace @rewards-platform/api run lint",
    "infra:up": "docker compose up --build -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f api postgres redis"
  },
  "devDependencies": {
    "neonctl": "^8.0.12"
  }
}
