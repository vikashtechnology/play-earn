# Local Docker Compose settings only. Replace before sharing this machine or
# deploying anywhere. The compose stack runs local PostgreSQL for development;
# staging and production use Neon (see apps/api/.env.example).
POSTGRES_DB=rewards_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=4000
JWT_SECRET=change-this-development-secret

# Firebase Auth (pass-through to the containerized API).
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Point the containerized API at Neon instead of the local Postgres service by
# setting this to the Neon pooled connection string.
API_POSTGRES_URL=
